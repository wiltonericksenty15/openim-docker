# etcd server tuning for OpenIM (service discovery, single-node)
# Edit this file and recreate the container to apply changes.

# Cluster identity
ETCD_NAME=s1
ETCD_DATA_DIR=/etcd-data

# Listeners (use service name for in-cluster discovery)
ETCD_LISTEN_CLIENT_URLS=http://0.0.0.0:2379
ETCD_ADVERTISE_CLIENT_URLS=http://etcd:2379
ETCD_LISTEN_PEER_URLS=http://0.0.0.0:2380
ETCD_INITIAL_ADVERTISE_PEER_URLS=http://etcd:2380
ETCD_INITIAL_CLUSTER=s1=http://etcd:2380
ETCD_INITIAL_CLUSTER_TOKEN=tkn
ETCD_INITIAL_CLUSTER_STATE=new

# Security: require auth when credentials are configured
ALLOW_NONE_AUTHENTICATION=no

# Auto compaction to control db growth
ETCD_AUTO_COMPACTION_MODE=periodic
ETCD_AUTO_COMPACTION_RETENTION=1h

# Backend quota (2GB); raise if keyspace grows large
ETCD_QUOTA_BACKEND_BYTES=2147483648

# Request & snapshot tuning
ETCD_MAX_REQUEST_BYTES=33554432
ETCD_SNAPSHOT_COUNT=50000

# gRPC keepalive for long-lived OpenIM client connections
ETCD_GRPC_KEEPALIVE_MIN_TIME=5s
ETCD_GRPC_KEEPALIVE_INTERVAL=2h
ETCD_GRPC_KEEPALIVE_TIMEOUT=20s

# Timing (single-node defaults are fine; slightly relaxed election)
ETCD_HEARTBEAT_INTERVAL=100
ETCD_ELECTION_TIMEOUT=1000

ETCD_LOG_LEVEL=info
