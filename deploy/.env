# deploy 目录专用环境变量（与根目录 .env 保持同步）
# 启动: ./up.sh [infra|app|front|monitor|all]  或  .\up.ps1 [目标]
#
# 内存规划 (32GB 主机，全量部署 infra + app + monitor)
#   容器 cgroup 合计 ~20GB，预留 ~12GB 给 OS / Docker / 峰值 / page cache
#   Mongo 3G | Redis 2.5G | Kafka 2G | Etcd 1G | MinIO 1.5G
#   OpenIM Server 5G | OpenIM Chat 1.5G | Prometheus 1.5G | Grafana 384M | Alertmanager 128M
#   前端 nginx 无 cgroup 限制，实测各 ~128M
#
# 端口映射 (宿主机可用范围 26200-26300，容器内端口不变)
#   26200 mongo | 26201 redis | 26202 etcd-client | 26203 etcd-peer | 26204 kafka
#   26205 minio-api | 26206 minio-console | 26207 im-gateway | 26208 im-api
#   26209 chat-api | 26210 admin-api | 26211 web-front | 26212 admin-front
#   26213 prometheus | 26214 alertmanager | 26215 grafana | 26216 node-exporter
#
# 配置文件索引:
#   mongo/config/mongod.conf    redis/config/redis.conf
#   kafka/config/kafka.env      etcd/config/etcd.env
#   minio/config/minio.env      prometheus/config/prometheus.yml

# Docker images
MONGO_IMAGE=mongo:7.0                      # MongoDB server image version
REDIS_IMAGE=redis:7.0.0                    # Redis server image version
KAFKA_IMAGE=bitnamilegacy/kafka:3.5.1            # Kafka server image version
MINIO_IMAGE=minio/minio:RELEASE.2024-01-11T07-46-16Z  # MinIO server image version
PROMETHEUS_IMAGE=prom/prometheus:v2.51.2   # Prometheus monitoring system image version
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0 # Alertmanager for Prometheus image version
GRAFANA_IMAGE=grafana/grafana:11.0.1       # Grafana visualization tool image version
ETCD_IMAGE=bitnamilegacy/etcd:3.5.13

OPENIM_WEB_FRONT_IMAGE=openim/openim-web-front:release-v3.8.3
OPENIM_ADMIN_FRONT_IMAGE=openim/openim-admin-front:release-v1.8.4-patch.2

NODE_EXPORTER_IMAGE=prom/node-exporter:v1.7.0 # Prometheus Node Exporter image version

# OpenIM server and chat service images
OPENIM_SERVER_IMAGE=openim/openim-server:v3.8.3-patch.12 # OpenIM server application image version
#OPENIM_SERVER_IMAGE=registry.cn-hangzhou.aliyuncs.com/openimsdk/openim-server:release-v3.8.3

OPENIM_CHAT_IMAGE=openim/openim-chat:v1.8.4-patch.2 # OpenIM chat application image version
#OPENIM_CHAT_IMAGE=registry.cn-hangzhou.aliyuncs.com/openimsdk/openim-chat:release-v1.8.4


# Directory for data storage (相对各服务 compose 文件所在目录)
DATA_DIR=./

# MongoDB configuration
MONGO_ADDRESS="mongo:27017"                # Address of MongoDB server
MONGO_PORT=26200                           # MongoDB host port
MONGO_ROOT_USERNAME=root                     # MongoDB root username
MONGO_ROOT_PASSWORD=openIM123              # MongoDB root password
MONGO_DATABASE=openim_v3                     # OpenIM database name
MONGO_USERNAME=openIM                        # OpenIM application username
MONGO_PASSWORD=openIM123                     # OpenIM application password
# Memory: MONGO_MEMORY_LIMIT + cacheSizeGB in mongo/config/mongod.conf (~50% of limit)
MONGO_MEMORY_LIMIT=3072M                   # Container memory limit; should exceed cache + ~512M overhead

# Kafka configuration
KAFKA_ADDRESS="kafka:9094"                 # Address of Kafka server
KAFKA_PORT=26204                            # Kafka external listener host port
KAFKA_MEMORY_LIMIT=2048M                   # Container memory limit; align with KAFKA_HEAP_OPTS in kafka.env
# KAFKA_USERNAME=openIM                      # Uncomment to enable SASL authentication
# KAFKA_PASSWORD=openIM123

# Etcd configuration
ETCD_ADDRESS="etcd:2379"
ETCD_CLIENT_PORT=26202                     # Etcd client host port
ETCD_PEER_PORT=26203                       # Etcd peer host port
ETCD_MEMORY_LIMIT=1024M                    # Container memory limit for coordination workloads
# ETCD_ROOT_USER=root                        # Uncomment to enable authentication
# ETCD_ROOT_PASSWORD=openIM123
# ETCD_USERNAME=openIM
# ETCD_PASSWORD=openIM123

# Redis configuration
REDIS_ADDRESS="redis:6379"                 # Address of Redis server
REDIS_PORT=26201                            # Redis host port
REDIS_PASSWORD=openIM123                   # Redis password
REDIS_MEMORY_LIMIT=2560M                   # Container limit; maxmemory in redis.conf should be ~80%

# MinIO configuration
MINIO_EXTERNAL_ADDRESS="http://external_ip:26205" # External address for MinIO needs to be manually modified
MINIO_INTERNAL_ADDRESS="minio:9000"        # Internal network address of MinIO
MINIO_ACCESS_KEY_ID=root                   # Access key ID for MinIO
MINIO_SECRET_ACCESS_KEY=openIM123          # Secret access key for MinIO
MINIO_PORT=26205                           # Port for MinIO server
MINIO_CONSOLE_PORT=26206                   # Console port for MinIO
MINIO_MEMORY_LIMIT=1536M                   # Container memory limit; raise for heavy object storage

# OpenIM configuration
OPENIM_SECRET=openIM123                    # Secret for OpenIM authentication
OPENIM_API_PORT=26208                      # API port for OpenIM server
OPENIM_MSG_GATEWAY_PORT=26207              # Message gateway port for OpenIM server
OPENIM_SERVER_MEMORY_LIMIT=5120M           # OpenIM server container memory limit
OPENIM_CHAT_MEMORY_LIMIT=1536M             # OpenIM chat container memory limit

# Ports for chat API and admin API
CHAT_API_PORT=26209                        # Chat service API port
ADMIN_API_PORT=26210                       # Admin API port

# Ports for OpenIM web and admin frontends
OPENIM_WEB_FRONT_PORT=26211                # Web frontend port for OpenIM
OPENIM_ADMIN_FRONT_PORT=26212              # Admin frontend port for OpenIM


# Monitoring
PROMETHEUS_PORT=26213                      # Port for Prometheus server
PROMETHEUS_MEMORY_LIMIT=1536M              # Prometheus container memory limit
PROMETHEUS_RETENTION_TIME=15d              # TSDB retention by time
PROMETHEUS_RETENTION_SIZE=8GB              # TSDB retention by size
ALERTMANAGER_PORT=26214                   # Port for Alert Manager
ALERTMANAGER_MEMORY_LIMIT=128M             # Alertmanager container memory limit
GRAFANA_PORT=26215                         # Port for Grafana
GRAFANA_MEMORY_LIMIT=384M                  # Grafana container memory limit
NODE_EXPORTER_PORT=26216                   # Port for Prometheus Node Exporter

# General settings
API_URL="http://openim-server:10002"       # API URL for OpenIM server
LOG_IS_STDOUT=true                         # Log output to standard out
LOG_LEVEL=3                                # Log level: 3 for production environments, 6 for test environments

GRAFANA_URL="http://external_ip:26215/"    # Define the URL for accessing the Grafana dashboard, specifying the external IP and port
