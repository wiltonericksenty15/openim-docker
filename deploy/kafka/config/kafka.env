# Kafka server tuning for OpenIM (KRaft single-node, Bitnami image)
# Edit this file and recreate the container to apply changes.
# Memory: align KAFKA_HEAP_OPTS with KAFKA_MEMORY_LIMIT in deploy/.env

# JVM heap (~50% of container memory for 2GB limit)
KAFKA_HEAP_OPTS=-Xms512m -Xmx1024m

# KRaft mode (controller + broker)
KAFKA_CFG_NODE_ID=0
KAFKA_CFG_PROCESS_ROLES=controller,broker
KAFKA_CFG_CONTROLLER_QUORUM_VOTERS=0@kafka:9093
KAFKA_CFG_CONTROLLER_LISTENER_NAMES=CONTROLLER

# Listeners (SASL overrides applied by docker-compose entrypoint when auth is enabled)
KAFKA_CFG_LISTENERS=INTERNAL://:9092,CONTROLLER://:9093,EXTERNAL://:9094
KAFKA_CFG_ADVERTISED_LISTENERS=INTERNAL://kafka:9092,EXTERNAL://kafka:9094
KAFKA_CFG_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT,INTERNAL:PLAINTEXT
KAFKA_CFG_INTER_BROKER_LISTENER_NAME=INTERNAL

# Topics
KAFKA_NUM_PARTITIONS=8
KAFKA_CFG_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_CFG_DEFAULT_REPLICATION_FACTOR=1
KAFKA_CFG_MIN_INSYNC_REPLICAS=1
KAFKA_CFG_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_CFG_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_CFG_TRANSACTION_STATE_LOG_MIN_ISR=1

# Thread pools & sockets
KAFKA_CFG_NUM_NETWORK_THREADS=8
KAFKA_CFG_NUM_IO_THREADS=16
KAFKA_CFG_NUM_RECOVERY_THREADS_PER_DATA_DIR=2
KAFKA_CFG_SOCKET_SEND_BUFFER_BYTES=1048576
KAFKA_CFG_SOCKET_RECEIVE_BUFFER_BYTES=1048576
KAFKA_CFG_SOCKET_REQUEST_MAX_BYTES=104857600

# Log retention & segments (7 days)
KAFKA_CFG_LOG_RETENTION_HOURS=168
KAFKA_CFG_LOG_SEGMENT_BYTES=1073741824
KAFKA_CFG_LOG_RETENTION_CHECK_INTERVAL_MS=300000
KAFKA_CFG_LOG_FLUSH_INTERVAL_MESSAGES=10000
KAFKA_CFG_LOG_FLUSH_INTERVAL_MS=1000

# Compression & message size (IM payloads)
KAFKA_CFG_COMPRESSION_TYPE=lz4
KAFKA_CFG_MESSAGE_MAX_BYTES=10485760
KAFKA_CFG_REPLICA_FETCH_MAX_BYTES=10485760

# Consumer groups & connections
KAFKA_CFG_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_CFG_CONNECTIONS_MAX_IDLE_MS=600000
