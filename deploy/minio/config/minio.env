# MinIO server tuning for OpenIM (avatars, images, voice, video)
# Edit this file and recreate the container to apply changes.

# Concurrent S3 API requests; raise for heavy upload bursts
MINIO_API_REQUESTS_MAX=2500
MINIO_API_REQUESTS_DEADLINE=10m

# Upload/download timeout for large files
MINIO_API_REMOTE_TRANSPORT_DEADLINE=2h

# Compress text-like objects at rest to save disk I/O
MINIO_COMPRESSION_ENABLE=on
MINIO_COMPRESSION_EXTENSIONS=.txt,.log,.csv,.json,.xml,.html,.css,.js,.svg
MINIO_COMPRESSION_MIME_TYPES=text/*,application/json,application/xml,application/javascript

# Expose /minio/v2/metrics/cluster for Prometheus
MINIO_PROMETHEUS_AUTH_TYPE=public
